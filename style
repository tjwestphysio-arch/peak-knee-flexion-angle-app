/* Base page */
body {
  font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
  margin: 16px;
  background: #000; /* black to match sketch */
  color: #fff;
  display: flex;
  justify-content: center;
}

/* Outer rounded shell */
.app-shell {
  width: 520px;
  max-width: calc(100% - 32px);
  border-radius: 28px;
  padding: 16px;
  box-sizing: border-box;
  border: 2px solid #ffffff;
  background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));
}

/* Header pill */
.app-header {
  display: flex;
  justify-content: center;
  margin-bottom: 12px;
}
.title-pill {
  padding: 10px 18px;
  border-radius: 10px;
  border: 1px solid #ffffff;
  color: #ffffff;
  font-weight: 700;
  background: transparent;
}

/* Controls layout */
.controls-row {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 12px;
}

.controls-left, .controls-right {
  display: flex;
  gap: 10px;
}

.controls-left button,
.controls-right button {
  padding: 8px 12px;
  border-radius: 8px;
  border: 1px solid #ffffff;
  background: transparent;
  color: #ffffff;
  cursor: pointer;
  min-width: 86px;
  font-weight: 600;
}

/* disabled state */
.controls-left button[disabled],
.controls-right button[disabled] {
  opacity: 0.45;
  cursor: default;
}

/* main area */
.main-area {
  display: flex;
  flex-direction: column;
  gap: 12px;
  align-items: center;
}

/* Video area - rounded rectangle */
.video-wrap {
  width: 100%;
  height: 320px;
  background: #000;
  border-radius: 16px;
  border: 1px solid #ffffff;
  overflow: hidden;
  position: relative;
}

/* ensure video and overlay fill the container */
#video, #overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Results row */
.results-row {
  display: flex;
  gap: 12px;
  width: 100%;
  justify-content: space-between;
}

/* result card */
.results-card {
  width: calc(50% - 6px);
  min-height: 110px;
  border-radius: 12px;
  border: 1px solid #ffffff;
  padding: 10px;
  box-sizing: border-box;
  background: rgba(255,255,255,0.01);
}

.results-card h3 {
  margin: 0 0 8px 0;
  font-size: 0.95rem;
  text-align: left;
  color: #ffffff;
}

.result-line {
  font-size: 0.9rem;
  margin: 4px 0;
  color: #e6eef6;
}

/* status bar */
.status-bar {
  margin-top: 12px;
  display: flex;
  gap: 8px;
  align-items: center;
}
.status-bar #status {
  padding: 6px 10px;
  background: rgba(255,255,255,0.03);
  border-radius: 6px;
  color: #a7d2ff;
}

/* small screens */
@media (max-width: 520px) {
  .app-shell { padding: 12px; width: calc(100% - 24px); }
  .video-wrap { height: calc((100vw - 48px) * 0.6); } /* adapt */
  .controls-left button, .controls-right button { min-width: 64px; padding: 8px; }
}

/* visually hide legacy section (kept for compatibility) */
.sr-only { position: absolute; left: -9999px; top: -9999px; }
